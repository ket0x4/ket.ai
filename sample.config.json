{
    "Version": "6.5",
    "BotName": "ket.ai",
    "GenCommand": "ket",
    "BotSetup": {
        "token": "TELEGRAM_BOT_TOKEN",
        "max_queue": 10,
        "random": true,
        "MaxMessagesPerGroup": 40,
        "TriggerProbability": 0.10
    },
    "BackendSetup": {
        "api_url": "OPENAI_COMPATIBLE_API_URL",
        "api_key": "API_KEY",
        "model": "LLM_MODEL",
        "input_length": 2048,
        "yt-language": "tr"
    },
    "logging": {
        "level": "info",
        "file": "ket.log"
    },
    "http_proxy": "HTTP_PROXY_ADDRESS:PORT"
}