{
	"telegram_bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
	"llm_provider": "gemini",
	"gemini_api_key": "YOUR_GEMINI_API_KEY",
	"gemini_model": "gemini-3.8-flash",
	"openai_api_key": "YOUR_OPENAI_API_KEY",
	"openai_base_url": "http://localhost:8080/v1",
	"openai_model": "default",
	"chat_history_limit": 8,
	"image_history_limit": 5,
	"default_reply_probability": 0.05,
	"db_path": "bot.db",
	"bot_owner_id": 123456789,
	"enable_web_search": true,
	"enable_code_execution": true,
	"enable_fetch_url": true,
	"sandbox_url": "http://localhost:8080",
	"sandbox_timeout_ms": 45000,
	"max_agent_steps": 3,
	"max_identical_tool_calls": 1,
	"max_tool_failures_per_tool": 3,
	"agent_context_max_chars": 80000,
	"gemini_min_request_interval_ms": 3500,
	"agent_timeout_ms": 180000,
	"rate_limit_messages_per_minute": 20,
	"rate_limit_generations_per_minute": 6,
	"rate_limit_api_per_minute": 120,
	"init_data_max_age_seconds": 86400,
	"log_level": "info",
	"log_dir": "logs",
	"log_max_size_mb": 5
}
