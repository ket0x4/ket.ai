{
	"name": "ket-ai",
	"version": "7.4.0",
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun build --compile --minify src/index.ts --outfile ket.exe",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@google/genai": "^2.18.0",
		"eslint": "^10.8.1",
		"grammy": "^1.45.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.67.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@types/node": "^26.2.0",
		"bun-types": "^1.4.0"
	}
}
